{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2023", "DOM"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": false,
		"noImplicitOverride": true,
		"isolatedModules": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"types": ["node"],
		"declaration": true,
		"sourceMap": true,
		"outDir": "dist",
		"rootDir": "."
	},
	"include": ["src", "test"]
}
